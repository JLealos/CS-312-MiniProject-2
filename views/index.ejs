<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
  </head>
  <body>
    <main>
      <h1><%= pageTitle %></h1>
      <p>Look up a Pokémon by name or number.</p>
      <form action="/" method="get">
        <label for="search">Pokémon name or number</label>
        <input id="search" name="search" type="text" value="<%= search %>"
          placeholder="pikachu or 25" maxlength="100" required aria-describedby="search-help">
        <button type="submit">Search</button>
        <a href="/">Clear search</a>
        <p id="search-help">Use the full name. For names with multiple words, use hyphens (for example, mr-mime).</p>
      </form>

      <form action="/types" method="get">
        <label for="type">Browse by type</label>
        <select id="type" name="type" required>
          <option value="">Choose a type</option>
          <% pokemonTypes.forEach((type) => { %>
            <option value="<%= type %>" <%= selectedType === type ? 'selected' : '' %>><%= displayName(type) %></option>
          <% }); %>
        </select>
        <button type="submit">Filter Pokémon</button>
      </form>
      <form action="/random" method="get">
        <button type="submit">Random Pokémon</button>
      </form>

      <section aria-labelledby="weather-heading">
        <h2 id="weather-heading">Pokémon for your weather</h2>
        <form action="/weather" method="get">
          <label for="city">City name</label>
          <input id="city" name="city" value="<%= city %>" placeholder="Phoenix"
            minlength="2" maxlength="100" required aria-describedby="city-help">
          <button type="submit">Find weather Pokémon</button>
          <p id="city-help">We use the first matching city. Check the location shown in your results.</p>
        </form>
        <% if (weather) { %>
          <h3><%= weather.location %></h3>
          <p>Current weather: <%= weather.condition %>, <%= weather.temperature %> °C.</p>
          <p>Suggested type: <strong><%= displayName(weather.type) %></strong>.</p>
          <p>These are our app's weather-themed suggestions, not official game mechanics.</p>
        <% } %>
      </section>
      <% if (matches) { %>
        <section aria-labelledby="type-heading">
          <h2 id="type-heading"><%= displayName(selectedType) %> Pokémon</h2>
          <p><%= matches.length %> matches. Select a Pokémon to view its details.</p>
          <% if (matches.length === 0) { %>
            <p>No Pokémon found for this type. Try another type.</p>
          <% } %>
          <ul>
            <% matches.forEach((name) => { %>
              <li><a href="/?search=<%= encodeURIComponent(name) %>"><%= displayName(name) %></a></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <% if (error) { %>
        <p role="alert"><%= error %></p>
      <% } %>

      <% if (pokemon) { %>
        <section aria-labelledby="pokemon-name">
          <h2 id="pokemon-name"><%= pokemon.name %> #<%= pokemon.id %></h2>
          <% if (pokemon.image) { %>
            <img src="<%= pokemon.image %>" alt="<%= pokemon.name %>" width="240" height="240">
          <% } else { %>
            <p>No image available.</p>
          <% } %>
          <dl>
            <dt>Types</dt>
            <dd><%= pokemon.types.join(', ') %></dd>
            <dt>Height</dt>
            <dd><%= pokemon.height %> m</dd>
            <dt>Weight</dt>
            <dd><%= pokemon.weight %> kg</dd>
          </dl>
          <h3>Abilities</h3>
          <ul>
            <% pokemon.abilities.forEach((ability) => { %>
              <li><%= ability.name %><%= ability.hidden ? ' (hidden ability)' : '' %></li>
            <% }); %>
          </ul>
          <table>
            <caption>Base stats</caption>
            <thead><tr><th scope="col">Stat</th><th scope="col">Value</th></tr></thead>
            <tbody>
              <% pokemon.stats.forEach((stat) => { %>
                <tr><th scope="row"><%= stat.name %></th><td><%= stat.value %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </section>
      <% } %>
    </main>
    <footer><p>Pokémon data provided by <a href="https://pokeapi.co/">PokéAPI</a>. Weather data by <a href="https://open-meteo.com/">Open-Meteo</a> under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p></footer>
  </body>
</html>
